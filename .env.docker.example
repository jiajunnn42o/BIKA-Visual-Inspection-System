# EXAMPLE ONLY. Do not commit a real .env.docker with secrets.
# Prefer copying your existing .env to .env.docker and changing only DB host.
SECRET_KEY=REPLACE_WITH_YOUR_EXISTING_SECRET_KEY
DATABASE_URL=postgresql+psycopg://BIKA_USER:BIKA_PASSWORD@host.docker.internal:5433/BIKA_DATABASE
BIKA_MODEL_VERSION=v4_2026-10-27
# Copy your working MAIL_*, TWILIO_* etc from your local .env if needed.
# BIKA_PRELOAD_MODEL is overridden to 0 in compose.yaml for Phase 1.
