# COPY to .env.handover, fill strong unique values, NEVER commit .env.handover.
# Use alphanumeric POSTGRES_PASSWORD: it is interpolated into a database URI.
POSTGRES_USER=bika_app
POSTGRES_DB=bika_inspection
POSTGRES_PASSWORD=
SECRET_KEY=
APP_PORT=5002
BIKA_MODEL_VERSION=v3_prawn_2026_10_25
# Optional email/SMS settings (configure separately before using email/SMS workflows)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
SMS_MODE=console
