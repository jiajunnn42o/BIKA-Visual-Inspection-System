/* =========================================================

   BIKA DASHBOARD — 1:1 REFERENCE LAYOUT

   ========================================================= */



.dashboard-page {

    --dash-brand: #741F2E;

    --dash-green: #7FA06F;

    --dash-red: #C65358;

    --dash-amber: #D69A45;



    --dash-ink: #252525;

    --dash-text: #3A3A3A;

    --dash-muted: #6E6E6E;

    --dash-soft: #7A7A7A;

    --dash-line: rgba(30, 30, 30, 0.055);

    --dash-track: rgba(30, 30, 30, 0.08);



    --dash-card: #FFFFFF;

    --dash-shadow:

        0 6px 22px rgba(20, 20, 20, 0.045),

        0 1px 4px rgba(20, 20, 20, 0.025);



    --dash-gap: 15px;



    width: 100%;

    min-width: 0;



    color: var(--dash-text);

}



html[data-theme="dark"] .dashboard-page {

    --dash-brand: #D9808C;

    --dash-ink: #F2F2F2;

    --dash-text: #DDDDDD;

    --dash-muted: #A8A8A8;

    --dash-soft: #9A9A9A;

    --dash-line: rgba(255, 255, 255, 0.07);

    --dash-track: rgba(255, 255, 255, 0.12);

    --dash-card: rgba(32, 32, 34, 0.92);

    --dash-shadow: 0 6px 22px rgba(0, 0, 0, 0.28);

}





/* =========================================================

   DESKTOP SHELL — rows size to their content

   ========================================================= */



@media (min-width: 1100px) {



    body.dashboard-screen .app-sidebar {

        border-right: 1px solid rgba(60, 60, 60, 0.08) !important;

        box-shadow: none !important;

    }



    body.dashboard-screen .app-main {

        border-left: 0 !important;

    }



    body.dashboard-screen .dashboard-page {

        display: grid;

        grid-template-rows: auto;

        row-gap: 24px;



        padding-bottom: 24px;

        box-sizing: border-box;

    }

}





/* =========================================================

   HEADER

   ========================================================= */



.dashboard-header {

    position: relative;

    min-width: 0;

    min-height: 62px;

    display: flex;

    align-items: flex-start;

    margin: 0;

}



.dashboard-heading h1 {

    margin: 0;

    color: var(--dash-ink);

    font-size: 27px;

    font-weight: 500;

    line-height: 1.15;

    letter-spacing: -0.01em;

}



.dashboard-heading p {

    margin: 6px 0 0;

    color: var(--dash-muted);

    font-size: 15px;

    font-weight: 400;

    line-height: 1.3;

}





/* =========================================================

   FILTER PILL

   ========================================================= */



/* Fallback position; dashboard.js aligns it to the theme toggle + bell. */

.dashboard-filter-wrap {

    position: absolute;

    top: 0;

    right: 128px;

    z-index: 30;

}



.dashboard-filter-button {

    height: 38px;

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 0 22px 0 20px;



    border: 0;

    border-radius: 999px;

    background: var(--dash-card);

    box-shadow: var(--dash-shadow);



    color: var(--dash-ink);

    font: inherit;

    font-size: 13.5px;

    font-weight: 500;

    white-space: nowrap;

    cursor: pointer;

}



.dashboard-filter-button svg {

    flex: 0 0 auto;

}



.dashboard-filter-menu[hidden] {

    display: none !important;

}



.dashboard-filter-menu {

    position: absolute;

    top: calc(100% + 8px);

    right: 0;

    width: 290px;

    overflow: hidden;

    border-radius: 15px;

    background: var(--dash-card);

    box-shadow: 0 18px 46px rgba(0, 0, 0, 0.14);

    box-sizing: border-box;

}



.dashboard-filter-option {

    width: 100%;

    min-height: 42px;

    display: flex;

    align-items: center;

    padding: 0 16px;

    border: 0;

    background: transparent;

    color: var(--dash-ink);

    font: inherit;

    font-size: 13px;

    text-align: left;

    cursor: pointer;

}



.dashboard-filter-option:hover,

.dashboard-filter-option.is-active {

    background: rgba(116, 31, 46, 0.055);

    color: var(--dash-brand);

}



.dashboard-custom-range {

    padding: 13px;

    border-top: 1px solid var(--dash-line);

}



.dashboard-custom-range > span {

    display: block;

    margin-bottom: 8px;

    color: var(--dash-muted);

    font-size: 11px;

    font-weight: 600;

    text-transform: uppercase;

    letter-spacing: 0.04em;

}



.dashboard-custom-range-grid {

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 8px;

}



.dashboard-custom-range small {

    display: block;

    margin-bottom: 4px;

    color: var(--dash-muted);

    font-size: 10px;

}



.dashboard-custom-range input {

    width: 100%;

    height: 35px;

    padding: 0 7px;

    border: 1px solid var(--dash-line);

    border-radius: 8px;

    background: transparent;

    color: var(--dash-ink);

    font: inherit;

    font-size: 11px;

    box-sizing: border-box;

}



.dashboard-custom-apply {

    width: 100%;

    min-height: 36px;

    margin-top: 9px;

    border: 0;

    border-radius: 9px;

    background: #741F2E;

    color: #FFFFFF;

    font: inherit;

    font-size: 11.5px;

    font-weight: 600;

    cursor: pointer;

}



html[data-theme="dark"] .dashboard-custom-range input {

    color-scheme: dark;

}





/* =========================================================

   SUMMARY STRIP

   ========================================================= */



.dashboard-summary-strip {

    width: 100%;

    height: 52px;

    min-height: 52px;



    display: flex;

    align-items: center;

    gap: 15px;



    margin: 0;

    padding: 0 24px;



    border-radius: 999px;

    background: var(--dash-card);

    box-shadow: var(--dash-shadow);



    box-sizing: border-box;

}



.dashboard-summary-icon {

    flex: 0 0 auto;

    color: #6A6A6A;

}



.dashboard-summary-strip p {

    margin: 0;

    display: flex;

    flex-wrap: wrap;

    column-gap: 14px;



    color: var(--dash-ink);

    font-size: 15px;

    font-weight: 400;

    line-height: 1.4;

}



.dashboard-summary-strip strong {

    color: var(--dash-brand);

    font-weight: 600;

}





/* =========================================================

   CARDS

   ========================================================= */



.dashboard-card {

    min-width: 0;

    min-height: 0;



    border: 0;

    border-radius: 18px;

    background: var(--dash-card);

    box-shadow: var(--dash-shadow);



    padding: 18px 20px;

    box-sizing: border-box;

}



.dashboard-card h2 {

    margin: 0;

    color: var(--dash-ink);

    font-size: 15.5px;

    font-weight: 600;

    line-height: 1.2;

}



.dashboard-card-heading p {

    margin: 5px 0 0;

    color: var(--dash-muted);

    font-size: 11px;

    font-weight: 400;

    line-height: 1.3;

}



.dashboard-card-heading p strong {

    color: var(--dash-brand);

    font-weight: 600;

}



.is-negative,

.is-risk {

    color: var(--dash-brand) !important;

    font-weight: 600 !important;

}



.is-positive,

.is-good {

    color: var(--dash-green) !important;

    font-weight: 600 !important;

}





/* =========================================================

   SHARED 3-COLUMN GRID

   ========================================================= */



.dashboard-top-grid,

.dashboard-lower-grid {

    width: 100%;

    min-width: 0;



    display: grid;

    grid-template-columns:

        minmax(0, 1fr)

        minmax(0, 1fr)

        minmax(280px, 0.708fr);

    column-gap: var(--dash-gap);



    box-sizing: border-box;

}



.dashboard-top-grid {

    min-height: 0;

    align-items: stretch;

    margin: 0;

}





/* =========================================================

   YIELD CARD

   ========================================================= */



.dashboard-yield-card {

    display: flex;

    flex-direction: column;

    padding: 20px 26px 20px 33px;

}



.dashboard-yield-value {

    display: block;

    margin-top: 9px;



    color: var(--dash-green);

    font-size: 56px;

    font-weight: 600;

    line-height: 0.95;

    letter-spacing: -0.04em;

}



.dashboard-yield-meta {

    display: flex;

    align-items: center;

    flex-wrap: wrap;

    gap: 4px;



    margin-top: 12px;

    margin-bottom: 18px;



    color: var(--dash-muted);

    font-size: 11.5px;

    font-weight: 400;

}



.dashboard-yield-meta strong {

    font-weight: 500;

}



.dashboard-yield-delta {

    display: inline-flex;

    align-items: center;

    gap: 4px;

    margin-left: 14px;

    color: var(--dash-green);

}



.dashboard-yield-delta[hidden] {

    display: none;

}



.dashboard-yield-delta.is-down {

    color: var(--dash-brand);

}



.dashboard-yield-delta-arrow {

    font-size: 9px;

    line-height: 1;

}



/* margin-top:auto keeps the bar on the card's bottom edge when the

   row is stretched by a taller neighbour. */

.dashboard-target-progress {

    position: relative;

    height: 13px;

    margin-top: auto;

    border-radius: 999px;

    background: var(--dash-track);

}



.dashboard-target-progress-fill {

    display: block;

    width: 0;

    height: 100%;

    border-radius: inherit;

    background: var(--dash-green);

    transition: width 220ms ease;

}



.dashboard-target-marker {

    position: absolute;

    top: -4px;

    left: 0;

    width: 2px;

    height: 21px;

    border-radius: 1px;

    transform: translateX(-1px);

    background: #5E5E62;

}



.dashboard-progress-labels {

    position: relative;

    height: 14px;

    margin-top: 8px;



    color: var(--dash-muted);

    font-size: 10px;

    font-weight: 400;

    line-height: 14px;

}



.dashboard-progress-labels > span {

    position: absolute;

    top: 0;

    white-space: nowrap;

}



.dashboard-progress-labels > span:first-child {

    left: 0;

}



.dashboard-progress-labels > span:last-child {

    right: 0;

}



.dashboard-progress-target-label {

    left: 85%;

    transform: translateX(-50%);

}





/* =========================================================

   COMPOSITION CARD

   ========================================================= */



.dashboard-composition-card {

    display: flex;

    flex-direction: column;

    padding: 20px 28px 18px 32px;

}



.dashboard-composition-bar {

    flex: 0 0 14px;

    height: 14px;

    display: flex;

    overflow: hidden;

    margin: 14px 0 0;

    border-radius: 999px;

    background: var(--dash-track);

}



.dashboard-composition-bar span {

    height: 100%;

    width: 0;

    transition: width 220ms ease;

}



/* Two columns, filled top-to-bottom (5 items → 3 + 2).

   --composition-rows is set in index.html = ceil(items / 2). */

.dashboard-composition-list {

    min-height: 0;

    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    grid-template-rows: repeat(var(--composition-rows, 3), auto);

    grid-auto-flow: column;

    column-gap: 32px;

    row-gap: 2px;

    margin-top: 12px;

}



.dashboard-composition-row {

    min-height: 22px;



    display: grid;

    grid-template-columns:

        6px

        minmax(0, 1fr)

        auto

        41px;

    align-items: center;

    column-gap: 10px;



    font-size: 12.5px;

    line-height: 1.2;

}



.dashboard-composition-dot {

    width: 6px;

    height: 6px;

    border-radius: 50%;

    background: #999999;

}



.dashboard-composition-name {

    overflow: hidden;

    color: #555555;

    font-weight: 500;

    text-overflow: ellipsis;

    white-space: nowrap;

}



.dashboard-composition-row strong {

    color: var(--dash-ink);

    font-weight: 500;

    text-align: right;

    font-variant-numeric: tabular-nums;

}



.dashboard-composition-row small {

    color: var(--dash-muted);

    font-size: 12.5px;

    font-weight: 400;

    text-align: right;

    font-variant-numeric: tabular-nums;

}



html[data-theme="dark"] .dashboard-composition-name {

    color: var(--dash-text);

}





/* =========================================================

   OVERALL VS TARGET

   ========================================================= */



.dashboard-target-card {

    display: flex;

    flex-direction: column;

    padding: 20px 30px 14px 18px;

}



.dashboard-target-table {

    min-height: 0;

    margin-top: 14px;

}



.dashboard-target-table-head,

.dashboard-target-table-row {

    display: grid;

    grid-template-columns:

        minmax(0, 1fr)

        62px

        61px

        61px;

    align-items: center;

    column-gap: 0;

}



.dashboard-target-table-head > span:not(:first-child),

.dashboard-target-table-row > span {

    text-align: right;

    font-variant-numeric: tabular-nums;

}



.dashboard-target-table-head {

    min-height: 18px;

    padding-bottom: 8px;

    border-bottom: 1px solid var(--dash-line);

    color: var(--dash-muted);

    font-size: 9px;

    font-weight: 500;

    letter-spacing: 0.04em;

    text-transform: uppercase;

}



.dashboard-target-table-row {

    min-height: 36px;

    border-bottom: 1px solid var(--dash-line);

    color: var(--dash-ink);

    font-size: 12px;

    font-weight: 500;

}



.dashboard-target-table-row:first-of-type {

    margin-top: 4px;

}



.dashboard-target-table-row:last-child {

    border-bottom: 0;

}



.dashboard-target-table-row strong {

    overflow: hidden;

    color: var(--dash-ink);

    font-size: 12px;

    font-weight: 500;

    text-overflow: ellipsis;

    white-space: nowrap;

}



.dashboard-target-table-row .dashboard-target-plain {

    color: var(--dash-muted);

    font-weight: 500;

}





/* =========================================================

   LOWER ROW

   ========================================================= */



.dashboard-lower-grid {

    min-height: 0;

    grid-template-areas: "trend trend side";

    align-items: stretch;

}



.dashboard-trend-card {

    grid-area: trend;

    min-height: 0;

    display: flex;

    flex-direction: column;

    padding: 20px 20px 10px 14px;

}



.dashboard-trend-heading {

    flex: 0 0 auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 16px;

    padding-left: 21px;

    padding-right: 25px;

}



.dashboard-trend-stats {

    display: flex;

    align-items: center;

    gap: 8px;

}



.dashboard-trend-stat {

    display: inline-flex;

    align-items: baseline;

    gap: 6px;

    padding: 6px 12px;

    border-radius: 999px;

    background: rgba(116, 31, 46, 0.05);

    white-space: nowrap;

}



.dashboard-trend-stat small {

    color: var(--dash-muted);

    font-size: 11px;

    font-weight: 400;

}



.dashboard-trend-stat strong {

    color: var(--dash-ink);

    font-size: 12px;

    font-weight: 600;

    font-variant-numeric: tabular-nums;

}



.dashboard-trend-stat.is-best strong {

    color: var(--dash-green);

}



.dashboard-trend-stat.is-worst strong {

    color: var(--dash-brand);

}



html[data-theme="dark"] .dashboard-trend-stat {

    background: rgba(255, 255, 255, 0.06);

}



.dashboard-trend-title {

    display: flex;

    align-items: center;

    gap: 12px;

}



.dashboard-trend-title svg {

    color: #6A6A6A;

}



.dashboard-trend-title h2 {

    font-size: 17px;

    font-weight: 600;

}



.dashboard-chart-wrap {

    position: relative;

    width: 100%;

    min-height: 300px;

    flex: 1 1 auto;

    margin-top: 8px;

}



.dashboard-chart {

    position: absolute;

    inset: 0;

    width: 100%;

    height: 100%;

    display: block;

    overflow: visible;

}



.dashboard-chart text {

    fill: var(--dash-soft);

    font-family: Inter, Arial, sans-serif;

}



.dashboard-chart .dashboard-chart-axis-title {

    fill: #555555;

    font-size: 11.5px;

    font-weight: 500;

}



.dashboard-chart .dashboard-chart-legend-text {

    fill: var(--dash-brand);

    font-size: 11.5px;

    font-weight: 500;

}



.dashboard-chart .dashboard-chart-value {

    fill: var(--dash-brand);

    font-size: 14px;

    font-weight: 700;

    paint-order: stroke;

    stroke: var(--dash-card);

    stroke-width: 4px;

    stroke-linejoin: round;

}



html[data-theme="dark"] .dashboard-chart .dashboard-chart-axis-title {

    fill: var(--dash-muted);

}



.dashboard-chart-tooltip[hidden] {

    display: none !important;

}



.dashboard-chart-tooltip {

    position: absolute;

    z-index: 10;

    min-width: 124px;

    padding: 8px 10px;

    border-radius: 9px;

    background: var(--dash-card);

    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);

    color: var(--dash-ink);

    font-size: 11.5px;

    line-height: 1.45;

    pointer-events: none;

    white-space: nowrap;

}





/* =========================================================

   RIGHT SIDE STACK

   ========================================================= */



/* Right column sizes to its content; the trend card stretches to match. */

.dashboard-side-stack {

    grid-area: side;

    min-width: 0;

    min-height: 0;

    display: grid;

    grid-template-rows: auto auto;

    gap: 16px;

}



.dashboard-camera-card {

    padding: 18px 30px 8px 18px;

}



.dashboard-cumulative-card {

    padding: 18px 30px 8px 18px;

}



.dashboard-camera-card .dashboard-card-heading p {

    font-size: 10.5px;

}



.dashboard-detail-list {

    margin: 8px 0 0;

}



.dashboard-detail-list > div {

    min-height: 34px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 12px;

    border-bottom: 1px solid var(--dash-line);

}



.dashboard-cumulative-card .dashboard-detail-list > div {

    min-height: 34px;

}



.dashboard-detail-list > div:last-child {

    border-bottom: 0;

}



.dashboard-detail-list dt {

    color: var(--dash-ink);

    font-size: 12px;

    font-weight: 500;

}



.dashboard-detail-list dd {

    margin: 0;

    color: var(--dash-text);

    font-size: 12.5px;

    font-weight: 400;

    text-align: right;

    white-space: nowrap;

    font-variant-numeric: tabular-nums;

}





/* =========================================================

   LOADING

   ========================================================= */



.dashboard-page.is-loading {

    cursor: wait;

}



.dashboard-page.is-loading .dashboard-card,

.dashboard-page.is-loading .dashboard-summary-strip {

    opacity: 0.7;

}





/* =========================================================

   RESPONSIVE / MOBILE

   ========================================================= */



@media (max-width: 1099px) {



    body.dashboard-screen {

        height: auto;

        overflow: auto !important;

    }



    body.dashboard-screen .app-shell,

    body.dashboard-screen .app-main,

    body.dashboard-screen .app-content {

        height: auto;

        overflow: visible !important;

    }



    .dashboard-page {

        height: auto;

        display: flex;

        flex-direction: column;

        gap: 14px;

    }



    .dashboard-header {

        flex-direction: column;

        gap: 12px;

    }



    .dashboard-filter-wrap {

        position: relative;

        top: auto;

        right: auto;

    }



    .dashboard-summary-strip {

        height: auto;

        min-height: 52px;

        padding: 12px 20px;

        border-radius: 20px;

    }



    .dashboard-top-grid {

        grid-template-columns: repeat(2, minmax(0, 1fr));

        row-gap: 14px;

    }



    .dashboard-target-card {

        grid-column: 1 / -1;

    }



    .dashboard-lower-grid {

        grid-template-columns: 1fr;

        grid-template-areas:

            "trend"

            "side";

        row-gap: 14px;

    }



    .dashboard-chart-wrap {

        min-height: 320px;

    }



    .dashboard-trend-heading {

        flex-wrap: wrap;

        padding-right: 0;

    }



    .dashboard-side-stack {

        grid-template-columns: repeat(2, minmax(0, 1fr));

        grid-template-rows: auto;

    }

}



@media (max-width: 720px) {



    .dashboard-top-grid,

    .dashboard-side-stack {

        grid-template-columns: 1fr;

    }



    .dashboard-target-card {

        grid-column: auto;

    }



    .dashboard-filter-menu {

        right: auto;

        left: 0;

        width: min(290px, calc(100vw - 42px));

    }

}



@media (max-width: 520px) {



    .dashboard-card,

    .dashboard-yield-card,

    .dashboard-composition-card,

    .dashboard-target-card {

        padding: 15px;

    }



    .dashboard-yield-value {

        font-size: 48px;

    }



    .dashboard-composition-list {

        grid-template-columns: 1fr;

        grid-template-rows: none;

        grid-auto-flow: row;

    }



    .dashboard-custom-range-grid {

        grid-template-columns: 1fr;

    }

}

/* =========================================================
   QUALITY TREND — BAD / GOOD RATIO SWITCH
   Isolated addition only. Existing dashboard layout unchanged.
   ========================================================= */

.dashboard-trend-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 10px;

    min-width: 0;
}

.dashboard-trend-metric-toggle {
    display: inline-flex;
    align-items: center;

    gap: 2px;

    padding: 3px;

    border-radius: 999px;

    background: rgba(30, 30, 30, 0.055);

    flex: 0 0 auto;
}

.dashboard-trend-metric-button {
    min-height: 28px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 11px;

    border: 0;
    border-radius: 999px;

    background: transparent;

    color: var(--dash-muted);

    font: inherit;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;

    cursor: pointer;
}

.dashboard-trend-metric-button:hover {
    color: var(--dash-ink);
}

.dashboard-trend-metric-button.is-active {
    background: var(--dash-card);

    color: var(--dash-ink);

    box-shadow:
        0 1px 4px
        rgba(20, 20, 20, 0.06);

    font-weight: 600;
}

.dashboard-chart .dashboard-chart-legend-text,
.dashboard-chart .dashboard-chart-value {
    fill:
        var(
            --dashboard-trend-colour,
            var(--dash-brand)
        );
}

html[data-theme="dark"] .dashboard-trend-metric-toggle {
    background:
        rgba(
            255,
            255,
            255,
            0.07
        );
}

@media (max-width: 1099px) {

    .dashboard-trend-actions {
        width: 100%;

        justify-content: space-between;

        flex-wrap: wrap;
    }

}

@media (max-width: 720px) {

    .dashboard-trend-actions {
        align-items: flex-start;

        flex-direction: column;
    }

}


/* =========================================================
   QUALITY TREND METRIC TOGGLE — directly beside title
   ========================================================= */

.dashboard-trend-title {
    min-width: 0;
}

.dashboard-trend-title .dashboard-trend-metric-toggle {
    margin-left: 8px;
}

.dashboard-trend-actions {
    margin-left: auto;
}

/* BIKA_DASHBOARD_ADMIN_INFO_V2 — matches System Configuration info tooltips */
.dashboard-page .dashboard-title-inline {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
}
.dashboard-page .dashboard-title-inline > h2 { margin: 0; }
.dashboard-page .config-info {
    position: relative;
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #9A9A9A;
    cursor: help;
    outline: none;
    transition: color 150ms ease, transform 150ms ease;
}
.dashboard-page .config-info-icon {
    width: 17px;
    height: 17px;
    display: block;
}
.dashboard-page .config-info:hover,
.dashboard-page .config-info:focus,
.dashboard-page .config-info:focus-visible {
    color: #741F2E;
    transform: translateY(-1px);
}
.dashboard-page .config-tooltip {
    position: absolute;
    z-index: 50;
    left: 50%;
    bottom: calc(100% + 9px);
    width: max-content;
    max-width: 240px;
    padding: 8px 10px;
    box-sizing: border-box;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    background: #FFFFFF;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.10);
    color: #4B4B4B;
    font-family: "Inter", Arial, sans-serif;
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
    text-align: left;
    white-space: normal;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%) translateY(3px);
    transition: opacity 140ms ease, transform 140ms ease, visibility 140ms ease;
}
.dashboard-page .config-tooltip::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translateX(-50%);
    border-width: 5px 5px 0 5px;
    border-style: solid;
    border-color: #FFFFFF transparent transparent transparent;
}
.dashboard-page .config-info:hover .config-tooltip,
.dashboard-page .config-info:focus .config-tooltip,
.dashboard-page .config-info:focus-visible .config-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
}
html[data-theme="dark"] .dashboard-page .config-info {
    color: rgba(255, 255, 255, 0.55);
}
html[data-theme="dark"] .dashboard-page .config-info:hover,
html[data-theme="dark"] .dashboard-page .config-info:focus,
html[data-theme="dark"] .dashboard-page .config-info:focus-visible {
    color: #FFFFFF;
}
html[data-theme="dark"] .dashboard-page .config-tooltip {
    border-color: rgba(255, 255, 255, 0.10);
    background: #28282A;
    color: #F0F0F0;
    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.26);
}
html[data-theme="dark"] .dashboard-page .config-tooltip::after {
    border-color: #28282A transparent transparent transparent;
}
.dashboard-page .dashboard-trend-title > .dashboard-title-inline { flex: 0 0 auto; }
@media (max-width: 520px) {
    .dashboard-page .dashboard-title-inline { gap: 6px; }
}

/* BIKA_TARGET_METRIC_INFO_V2_VISIBLE_FIX — show complete metric labels */
.dashboard-page .dashboard-target-name-tail {
    display: inline-block;
    white-space: nowrap;
}
.dashboard-page .dashboard-target-table-row > .dashboard-target-name-cell {
    display: block;
    min-width: 0;
    overflow: visible;
    white-space: normal;
    line-height: 1.45;
}
.dashboard-page .dashboard-target-name-cell strong {
    display: inline;
    min-width: 0;
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    overflow-wrap: normal;
    font-size: inherit;
    font-weight: 500;
    color: var(--dash-ink);
}
.dashboard-page .dashboard-target-name-cell .config-info {
    display: inline-flex;
    vertical-align: middle;
    align-items: center;
    justify-content: center;
    position: relative;
    flex: 0 0 15px;
    width: 15px;
    height: 15px;
    min-width: 15px;
    overflow: visible;
    margin: 0 0 0 4px;
    padding: 0;
    cursor: help;
}
.dashboard-page .dashboard-target-name-cell .config-info-icon {
    width: 15px;
    height: 15px;
    display: block;
}
.dashboard-page .dashboard-target-name-cell .config-tooltip {
    min-width: 160px;
    max-width: 220px;
    font-weight: 400;
}
.dashboard-page .dashboard-target-table-row {
    overflow: visible;
    padding-top: 8px;
    padding-bottom: 8px;
}
